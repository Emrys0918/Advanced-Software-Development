@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

title 快递物流：包裹处理与运输调度（领域模型）

'========================
' 枚举 / 值对象
'========================
enum 包裹状态 {
  已创建 (CREATED)
  已揽收 (COLLECTED)
  分拣中 (SORTING)
  运输中 (IN_TRANSIT)
  到达中转站 (ARRIVED_AT_HUB)
  派送中 (OUT_FOR_DELIVERY)
  已签收 (DELIVERED)
  异常 (EXCEPTION)
  退回中 (RETURNING)
}

enum 异常类型 {
  分拣地址不详 (SORTING_ADDRESS_UNCLEAR)
  分拣标签损坏 (SORTING_LABEL_DAMAGED)
  运输路线变更 (ROUTE_CHANGED)
  收件人不在家 (DELIVERY_RECIPIENT_ABSENT)
  派送地址错误 (DELIVERY_ADDRESS_WRONG)
  包裹破损 (DELIVERY_DAMAGED)
}

class 地址 <<值对象>> {
  +省份
  +城市
  +区县
  +详细地址
  +邮编
  +地理坐标点
}

class 联系人 <<值对象>> {
  +姓名
  +电话
}

class 尺寸 <<值对象>> {
  +长
  +宽
  +高
}

class 重量 <<值对象>> {
  +千克
}

class 路线规划 <<值对象>> {
  +路线ID
  +节点列表 : List<Node>
  +预计到达时间
}

class 节点 <<值对象>> {
  +节点ID
  +节点类型 '网点/中转站/分拣中心
  +顺序
}

'========================
' 参与方
'========================
class 客户 {
  +客户ID
  +姓名
  +类型 '寄件人/收件人
}

class 员工 {
  +员工ID
  +姓名
  +角色 '网点人员/调度员/司机/派送员
}

class 司机 extends 员工
class 派送员 extends 员工
class 调度员 extends 员工
class 网点工作人员 extends 员工

'========================
' 组织与站点
'========================
abstract class 站点 {
  +站点ID
  +名称
  +站点类型 '网点/中转站/分拣中心
  +地址 : 地址
}

class 网点 extends 站点
class 转运中心 extends 站点
class 分拣中心 extends 站点

'========================
' 核心聚合：运单 & 包裹
'========================
class 运单 <<聚合根>> {
  +运单号
  +创建时间
  +服务类型
  +寄件人联系方式 : 联系人
  +收件人联系方式 : 联系人
  +寄件地址 : 地址
  +收件地址 : 地址
  +声明重量 : 重量
  +声明尺寸 : 尺寸
}

class 包裹 <<聚合根>> {
  +包裹ID
  +状态 : 包裹状态
  +当前站点ID
  +下一站站点ID
  +预计到达时间
}

运单 "1" o-- "1..*" 包裹 : 包含/对应
客户 "1" -- "0..*" 运单 : 发起寄件(寄件人)
客户 "1" -- "0..*" 运单 : 收件人信息(收件人)

网点工作人员 "1" -- "0..*" 运单 : 录入/打印
网点 "1" -- "0..*" 运单 : 创建于网点

'========================
' 轨迹：包裹全生命周期追溯
'========================
class 轨迹事件 {
  +事件ID
  +发生时间
  +状态 : 包裹状态
  +站点ID
  +描述
}
'0： 当包裹刚刚在系统创建，还没被扫描揽收时，它还没有任何物理轨迹。随着包裹在不同城市间转运，每经过一个扫描动作（入库、出库、装车、签收），都会产生一条新的轨迹记录。
包裹 "1" o-- "0..*" 轨迹事件 : 轨迹/状态历史
轨迹事件 "*" --> "1" 站点 : 发生于

'========================
' 分拣与分拣规则
'========================
class 分拣规则 {
  +规则ID
  +名称
  +条件
  +目标站点ID
}

class 分拣作业 {
  +作业ID
  +执行时间
  +结果下一站ID
}

分拣中心 "1" o-- "0..*" 分拣规则
包裹 "0..*" -- "0..*" 分拣作业 : 被分拣
分拣作业 "*" --> "1" 分拣中心 : 在此执行

'========================
' 运输调度与任务管理
'========================
class 运输任务 <<聚合根>> {
  +任务ID
  +任务编号
  +任务日期
  +起始站点ID
  +目的站点ID
  +状态 '已规划/已分配/执行中/已完成/已更新
  +路线规划 : 路线规划
  +装载数量
}

class 车辆 {
  +车辆ID
  +车牌号
  +载数容量
  +载重容量
  +状态
}

class 装载清单 {
  +清单ID
  +创建时间
  +包裹数量
}

运输任务 "1" o-- "1" 装载清单 : 关联
装载清单 "1" o-- "1..*" 包裹 : 装载包裹

调度员 "1" -- "0..*" 运输任务 : 安排/调整
司机 "1" -- "0..*" 运输任务 : 执行运输
车辆 "1" -- "0..*" 运输任务 : 承运

运输任务 "*" --> "1" 站点 : 起始站
运输任务 "*" --> "1" 站点 : 目的站

'========================
' 末端派送任务
'========================
class 派送任务 <<聚合根>> {
  +派送任务ID
  +创建时间
  +站点ID '目的网点
  +状态 '已分配/派送中/已妥投/失败/重试
  +建议派送路线
}

class 派送明细 {
  +明细ID
  +顺序
}

派送任务 "1" o-- "1..*" 派送明细
派送明细 "*" --> "1" 包裹

网点 "1" -- "0..*" 派送任务 : 生成/归属目的网点
派送员 "1" -- "0..*" 派送任务 : 执行派送

class 签收凭证 {
  +凭证ID
  +签收时间
  +签收人姓名
  +签名图片URL
  +备注
}

派送任务 "0..1" o-- "0..1" 签收凭证 : 签收凭证

'========================
' 异常处理（扩展流程）
'========================
class 异常案卷 <<聚合根>> {
  +异常ID
  +类型 : 异常类型
  +创建时间
  +状态 '待处理/处理中/已解决/已结案
  +描述
  +解决方案
}
'每一个异常必须明确落实到一个具体的物理实体上
异常案卷 "*" --> "1" 包裹 : 关联包裹
'如果是0，比如“包裹标签脱落”，这只是包裹个体问题，不影响车。
'如果是 1： 比如“运输车辆追尾”。这时案卷会关联到 运输任务
异常案卷 "*" --> "0..1" 运输任务 : 可能影响运输

异常案卷 "*" --> "0..1" 派送任务 : 可能影响派送
员工 "1" -- "0..*" 异常案卷 : 处理人

'========================
' 路线规划服务（领域服务）
'========================
class 路线规划服务 <<领域服务>> {
  +规划路线(寄件地址, 收件地址) : 路线规划
  +重新规划(任务ID, 约束条件) : 路线规划
}
' 依据寄件和收件地址规划路线（依赖关系）
路线规划服务 ..> 运单     
'为运输任务规划或调整路线
路线规划服务 ..> 运输任务  
'获取站点间距离和路径信息
路线规划服务 ..> 站点     
@enduml